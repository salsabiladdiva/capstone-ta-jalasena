# ============================================
# JALASENA Backend - Konfigurasi Environment
# ============================================
# Salin file ini menjadi .env dan isi dengan kredensial yang sesuai

# Kunci rahasia Django (ganti dengan kunci acak yang aman)
SECRET_KEY=ganti-dengan-kunci-rahasia-anda

# Mode debug (nonaktifkan di produksi)
DEBUG=True

# Konfigurasi Database Supabase (PostgreSQL)
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=password-supabase-anda
SUPABASE_DB_HOST=db.xxxxx.supabase.co
SUPABASE_DB_PORT=5432

# TODO: Integrasi Copernicus Marine Service API
# COPERNICUS_USERNAME=username-copernicus-anda
# COPERNICUS_PASSWORD=password-copernicus-anda
# COPERNICUS_API_URL=https://marine.copernicus.eu/api
